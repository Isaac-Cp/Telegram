# Production template. Copy into your deployment secrets manager, not into git.

ENVIRONMENT=production
API_V1_PREFIX=/api/v1

# Required production infrastructure
DATABASE_URL=postgresql+asyncpg://app_user:replace-with-password@db.example.com:5432/slie_db
DATABASE_SSL_ROOT_CERT=/etc/ssl/certs/ca-certificates.crt
REDIS_URL=rediss://:replace-with-password@redis.example.com:6380/0

# Required production security
SECRET_KEY=replace-with-a-unique-32-plus-character-production-secret
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_CONTROL_PASSWORD=
DASHBOARD_PASSWORD_HASH=replace-with-passlib-bcrypt-hash
DASHBOARD_CONTROL_PASSWORD_HASH=replace-with-control-passlib-bcrypt-hash
TRUSTED_ORIGINS=https://dashboard.example.com
TRUSTED_HOSTS=dashboard.example.com

# Provider credentials
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
API_ID=
API_HASH=
PHONE_NUMBER=
SESSION_STRING=
TELEGRAM_ENABLED=true

# Runtime controls
SCHEDULER_ENABLED=true
BACKGROUND_WORKERS_ENABLED=true
AUTO_CREATE_TABLES=false
LOG_LEVEL=INFO
TIMEZONE=Africa/Lagos

# Monitoring
SENTRY_DSN=
