# Local example environment variables for Telegram support CRM
# Copy this file to .env before starting the app.

API_ID=
API_HASH=
PHONE_NUMBER=
SESSION_STRING=
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/slie_db
DATABASE_SSL_ROOT_CERT=
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-strong-32-plus-character-secret
DASHBOARD_ADMIN_PASSWORD=replace-with-a-strong-dashboard-password
DASHBOARD_CONTROL_PASSWORD=replace-with-a-strong-control-password
# Prefer DASHBOARD_PASSWORD_HASH in production instead of a plain password.
DASHBOARD_PASSWORD_HASH=
DASHBOARD_CONTROL_PASSWORD_HASH=
TRUSTED_ORIGINS=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
TIMEZONE=Africa/Lagos
SCHEDULER_ENABLED=true
AUTO_CREATE_TABLES=false
LOG_LEVEL=INFO
BACKGROUND_WORKERS_ENABLED=true
TELEGRAM_ENABLED=false
EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
